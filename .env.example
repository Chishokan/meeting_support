# 社内契約の Claude API キー。Vercel の環境変数にも同名で設定する（ブラウザには渡らない）。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ログイン時の共通合言葉（テスト版の簡易認証）。空にすると合言葉なしで入れる。
ACCESS_CODE=chishokan2026

# 使用モデル（任意・既定 claude-sonnet-5）
# ★設定するとコード側の既定より優先される。モデルを変えたのに反映されないときはここを疑う。
AGENT_MODEL=claude-sonnet-5

# 議事録スプレッドシート保存（任意）。Apps Script の Web アプリ URL とトークン。
# 未設定でもアプリは動作する（議事録はブラウザ内 localStorage に保持される）。
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# 「部門会議議事録」の音声文字起こし（任意）。
# ★Claude は音声を直接読めないため、文字起こしだけ外部の音声認識サービスを使う。
#   OpenAI 互換の /v1/audio/transcriptions を持つサービスならどれでも使える
#   （OpenAI・Groq・Azure OpenAI・自前の faster-whisper など）。
#   未設定でもアプリは動作する（画面が「文字起こしを貼り付け」に切り替わる）。
SPEECH_API_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_API_KEY=
SPEECH_MODEL=whisper-1
SPEECH_LANGUAGE=ja
