# 社内契約の Claude API キー。Vercel の環境変数にも同名で設定する（ブラウザには渡らない）。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ログイン時の共通合言葉（テスト版の簡易認証）。空にすると合言葉なしで入れる。
ACCESS_CODE=chishokan2026

# 使用モデル（任意・既定 claude-sonnet-5）
# ★設定するとコード側の既定より優先される。モデルを変えたのに反映されないときはここを疑う。
AGENT_MODEL=claude-sonnet-5

# 議事録スプレッドシート保存（任意）。Apps Script の Web アプリ URL とトークン。
# 未設定でもアプリは動作する（議事録はブラウザ内 localStorage に保持される）。
# ★問合せ管理（/inquiry-board）もこの Apps Script 経由でスプレッドシート「問合せ台帳」に保存する。
#   未設定のとき：ローカル開発では .data/inquiry-board.json に保存、Vercel 本番では「未設定」と表示。
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# HP（WordPress）の問い合わせフォームから問合せ台帳へ直接取り込むときの合言葉（任意）。
# WordPress 側の Webhook 設定で、送信先 URL を https://<このアプリ>/api/inquiry-board/intake にし、
# ヘッダ X-Intake-Token（または ?token=）にこの値を付ける。未設定のあいだは受け口が閉じている。
INQUIRY_INTAKE_TOKEN=

# 「今日の注意点」AI の一言を毎朝まとめて生成する cron（vercel.json）の合言葉（任意）。
# Vercel の環境変数に設定すると、Vercel が cron 実行時に Authorization: Bearer <この値> を付けて来る。
# 未設定でも画面を最初に開いたときに生成されるので動作はする（時刻が朝に揃わないだけ）。
CRON_SECRET=

# 「部門会議議事録」の音声文字起こし（任意）。Google AI Studio（Gemini API）を使う。
# ★Claude は音声を直接読めないため、文字起こしだけ Gemini に任せている。
#   キーは https://aistudio.google.com/apikey で発行する。
#   未設定でもアプリは動作する（画面が「文字起こしを貼り付け」に切り替わる）。
GEMINI_API_KEY=

# 使用モデル（任意・既定 gemini-3.6-flash）。新しいモデルに乗り換えるときだけ設定する。
GEMINI_MODEL=gemini-3.6-flash

# エンドポイントの土台（任意・既定 https://generativelanguage.googleapis.com/v1beta）。通常は設定不要。
GEMINI_API_URL=
